string standalone.dv_verify_account(String account_id, String reason, String user_id, String user_email, map crmAPIRequest)
{
	result = Map();
	if(ifnull(account_id,"") == "")
	{
		req = ifnull(crmAPIRequest,Map());
		params = ifnull(req.get("params"),Map());
		body_text = ifnull(req.get("body"),"").toString();
		args_text = params.get("arguments");
		if(args_text == null && body_text.contains("arguments"))
		{
			args_text = body_text.toMap().get("arguments");
		}
		if(args_text != null)
		{
			sent = args_text.toString().toMap();
		}
		else if(body_text.contains("account_id"))
		{
			sent = body_text.toMap();
		}
		else
		{
			sent = params;
		}
		account_id = ifnull(sent.get("account_id"),"");
		reason = ifnull(sent.get("reason"),"");
		user_id = ifnull(sent.get("user_id"),"");
		user_email = ifnull(sent.get("user_email"),"");
	}
	if(ifnull(account_id,"") == "")
	{
		params_text = ifnull(crmAPIRequest.get("params"),"").toString();
		if(params_text.length() > 300)
		{
			params_text = params_text.subString(0,300);
		}
		body_text2 = ifnull(crmAPIRequest.get("body"),"").toString();
		if(body_text2.length() > 300)
		{
			body_text2 = body_text2.subString(0,300);
		}
		result.put("ok",false);
		result.put("message","No account id received. params=" + params_text + " | body=" + body_text2);
		return result.toString();
	}
	acc_id = account_id.toLong();
	rec = zoho.crm.getRecordById("Accounts",acc_id);
	if(rec.get("id") == null)
	{
		result.put("ok",false);
		result.put("message","Account not found.");
		return result.toString();
	}
	attachments = zoho.crm.getRelatedRecords("Attachments","Accounts",acc_id);
	if(attachments == null)
	{
		attachments = List();
	}
	notes = zoho.crm.getRelatedRecords("Notes","Accounts",acc_id);
	if(notes == null)
	{
		notes = List();
	}
	count = attachments.size();
	file_fields = List();
	file_fields.add("BIR_Registration_COR");
	file_fields.add("Business_registration");
	file_fields.add("Business_Permit");
	file_fields.add("General_Information_Sheet");
	for each  fld in file_fields
	{
		val = rec.get(fld);
		if(val != null)
		{
			count = count + val.size();
		}
	}
	for each  n in notes
	{
		note_files = n.get("$attachments");
		if(note_files != null)
		{
			count = count + note_files.size();
		}
	}
	if(count == 0)
	{
		result.put("ok",false);
		result.put("message","No documents found on this Account. Please attach the BIR 2303, DTI or SEC certificate and Mayors / Business Permit, then click Verify Account again.");
		return result.toString();
	}
	requested_by = Map();
	requested_by.put("id",ifnull(user_id,""));
	requested_by.put("email",ifnull(user_email,""));
	now_text = zoho.currenttime.toString("yyyy-MM-dd HH:mm:ss").replaceAll(" ","T") + "+08:00";
	payload = Map();
	payload.put("account_id",account_id);
	payload.put("customer_number",ifnull(rec.get("Inventory_Customer_Number"),""));
	payload.put("reason",ifnull(reason,""));
	payload.put("document_status","YES");
	payload.put("attachment_count",count);
	payload.put("requested_by",requested_by);
	payload.put("requested_at",now_text);
	payload.put("source","crm_button");
	payload.put("account",rec);
	payload.put("attachments",attachments);
	payload.put("notes",notes);
	engine_url = zoho.crm.getOrgVariable("dv_engine_url") + "/v1/jobs";
	request_headers = Map();
	request_headers.put("Content-Type","application/json");
	resp = invokeurl
	[
		url :engine_url
		type :POST
		parameters:payload.toString()
		headers:request_headers
		connection:"dv_engine"
	];
	resp_text = resp.toString();
	if(resp_text.contains("job_id"))
	{
		answer = resp_text.toMap();
		if(answer.get("created") == true)
		{
			result.put("ok",true);
			result.put("message","Verification started for " + count + " document(s). The result will appear in Document Verifications (related list below) in 1-3 minutes.");
			return result.toString();
		}
		result.put("ok",true);
		result.put("message","A verification for this Account is already in progress. Please check Document Verifications in a few minutes.");
		return result.toString();
	}
	if(resp_text.contains("Invalid API key"))
	{
		result.put("ok",false);
		result.put("message","The verification engine rejected the request (API key). Please contact the CRM admin.");
		return result.toString();
	}
	result.put("ok",false);
	if(resp_text.length() > 300)
	{
		resp_text = resp_text.subString(0,300);
	}
	result.put("message","The verification engine did not start the check: " + resp_text);
	return result.toString();
}
