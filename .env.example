# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO
# Shared secret Zoho (Deluge) sends in the X-API-Key header. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
API_KEY=change-me

# ---- Database / queue ----
DATABASE_URL=postgresql+psycopg://dv:dv@postgres:5432/dv
REDIS_URL=redis://redis:6379/0

# ---- Zoho CRM (US data center) ----
# Client ID/Secret from the API Console Self Client. Fill ZOHO_REFRESH_TOKEN with:
#   python scripts/zoho_auth.py exchange-code     (see docs/zoho-auth.md)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_API_VERSION=v8
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ---- File storage ----
# local = files on disk (dev). s3 = any S3-compatible store (Supabase Storage S3, AWS S3, R2).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/files
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_BUCKET=dv-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- AI extraction (Phase 1C) ----
# anthropic | openai | none (none = stop after OCR/classification)
EXTRACTION_PROVIDER=none
# Optional for anthropic (default claude-sonnet-5-5); required for openai:
#   gpt-6-luna (cheapest), gpt-6.1-sol (balanced), gpt-6-astra (most capable)
EXTRACTION_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI reasoning effort: none (luna only) | low | medium | high
EXTRACTION_REASONING_EFFORT=low

# ---- Automatic Zoho updates for high-confidence values ----
# off = never; shadow = record what WOULD be updated, write nothing; on = write to Zoho
# (needs the ZohoCRM.modules.accounts.UPDATE scope). Rules: app/assessment/policy.py
AUTO_APPLY_MODE=off
AUTO_APPLY_THRESHOLD=0.95
# Alerts (same mode): Note on the Account + Task for the Account owner
ALERT_TASKS=true
ALERT_TASK_DUE_DAYS=3
ALERT_REPEAT_AFTER_DAYS=7

# ---- Limits ----
MAX_FILE_BYTES=26214400

# ---- Monitoring (optional) ----
SENTRY_DSN=
